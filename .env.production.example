# ===========================================================================
#  CONTOH KONFIGURASI PRODUKSI  -  .env.production.example
#
#  CARA PAKAI
#  ---------------------------------------------------------------------------
#  Di lokal        : cp .env.production.example .env.production
#                    Lalu ubah APP_URL, dan HAPUS blok DATABASE_URL
#                    (pakai DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD)
#  Di Render       : JANGAN menyalin file ini. Salin tiap baris satu per satu ke
#                    Render > (service) > Environment > Environment Variables.
#                    Baris yang berawalan # TIDAK diimpor -- itu komentar untukmu.
#                    Jauh lebih cepat: pakai render.yaml, semua isian sudah ada di sana.
#  Di Docker lokal : docker run --env-file .env.production ...
#
#  BERKAS INI TIDAK BOLEH DI-COMMIT. .env.production sudah masuk .gitignore,
#  dan Dockerfile/.dockerignore tidak pernah menyalin .env* ke dalam image.
#
#  ============================================================== ATURAN EMAS
#  * Semua nilai di sini hanya DEFAULTS. Yang dipakai aplikasi adalah
#    ENVIRONMENT VARIABLE milik Render. render.yaml dan Dockerfile tidak pernah
#    menimpa nilai yang kamu set di dashboard.
#  * APP_KEY harus DIBUAT sendiri, tidak boleh menyalin contoh di bawah.
#  * Kalau kamu memakai `php artisan config:cache`, semua nilai di sini
#    DIBEKUK saat container start. Mengubah variable di Render tanpa deploy ulang
#    tidak akan berefek apa-apa.
# ===========================================================================


# ###########################################################################
#  1. APLIKASI  -  WAJIB
# ###########################################################################

# Nama aplikasi. Dipakai pada judul halaman, nama cookie session, dan prefix
# cache. Boleh pakai spasi.
APP_NAME="SIMRS RSP Rotinsulu"

# Mode aplikasi. WAJIB "production" di Render. Nilai lain ("local", "staging")
# membuat beberapa perilaku berubah, mis. tampilkan halaman error detail.
APP_ENV=production

# KUNCI ENKRIPSI APLIKASI  -  WAJIB, dan HARUS DIBUAT SENDIRI.
#
# Dipakai untuk: enkripsi cookie session, Remember-Me token, dan semua nilai
# yang disimpan lewat Crypt::encrypt(). Begitu diganti, semua pengguna yang sedang
# login akan langsung logout.
#
# Cara membuat (JALANKAN DI LOKAL, lalu salin hasilnya):
#     php artisan key:generate --show
# Outputnya seperti: base64:AbCdEf...==
#
#  JANGAN pernah commit nilai APP_KEY asli ke Git. Kalau bocor, siapa pun yang
#  mendapatkannya bisa memalsukan session cookie milik orang lain.
APP_KEY=

# Mode debug. WAJIB false di produksi.
# true  = setiap exception menampilkan stack trace lengkap, termasuk nilai
#         env dan potongan query. Ini membocorkan struktur database.
# false = halaman error bersih, dan detail lengkap hanya ditulis ke log (lihat LOG_LEVEL).
# Catatan: dengan false, pesan error yang unhelpful hanya bisa dibaca lewat log
# Render (Dashboard > service > Logs), BUKAN dari browser.
APP_DEBUG=false

# URL dasar aplikasi TANPA garis miring di akhir.
#
# WAJIB diset PERSIS sama dengan URL publik service Render kamu. Render memberi
# URL gratis dengan bentuk https://simrs-ews-app.onrender.com - itulah yang harus
# dipakai. Nilai ini dipakai untuk:
#   - URL absolut pada redirect, email, dan link di dalam halaman
#   - pembentukan URL pada Inertia (X-Inertia-Location)
#   - validasi Origin/Referer untuk proteksi CSRF
#
# Salah set = link setelah login melompat ke localhost, atau 419 Token Mismatch.
#
# Kalau nanti memakai domain kustom (mis. https://simrs.rotinsulu.go.id), ganti
# nilainya ke domain itu. Render sudah mengakhiri TLS di depan service, jadi
# SESSION_SECURE_COOKIE tetap harus true.
#
# GANTI placeholder di bawah dengan URL punyamu sendiri.
APP_URL=https://GANTI-DENGAN-URL-SERVICE-RENDER-ANDA

# Bahasa aplikasi dan format tanggal. SELURUH antarmuka ditulis dalam Bahasa
# Indonesia, jadi locale produksi harus "id" supaya format tanggal, angka, dan
# pesan validasi juga Bahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
# Locale untuk data dummy (seeder/testing). SENGAJA TETAP en_US, jangan diubah
# ke id_ID: paket fakerphp/faker tidak punya locale id_ID, sehingga menggantinya
# membuat `php artisan db:seed` gagal. Nilai ini hanya dipakai saat membuat data
# contoh dan tidak memengaruhi tampilan produksi.
APP_FAKER_LOCALE=en_US

# Mode "!down" (halaman maintenance). "file" berarti file
# storage/framework/down; "database" berarti tabel. Jangan ubah kecuali kamu
# memang punya halaman maintenance sendiri.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Kunci enkripsi lama, dipisah koma. Diisi SESUAI kalau kamu rotasi APP_KEY,
# supaya cookie lama masih bisa dibaca selama masa transisi.
APP_PREVIOUS_KEYS=

# Strength hash password (bcrypt). 12 = nilai yang direkomendasikan. Jangan naikkan ke 14 tanpa
# menguji dulu: setiap proses login menjadi jauh lebih lambat karena bcrypt
# sengaja dibuat lambat. Nilai < 10 jangan pernah dipakai.
BCRYPT_ROUNDS=12


# ###########################################################################
#  2. DATABASE  -  WAJIB (pilih SATU dari dua cara di bawah)
# ###########################################################################
#
#  Apps ini memakai PostgreSQL di produksi, SQLite di lokal. Keduanya
#  didukung oleh driver yang sudah terpasang di image.
DB_CONNECTION=pgsql

#  ---------------------------------------------------------------------------
#  2A. CARA A (REKOMENDASI untuk Render)  ->  pakai DATABASE_URL
#  ---------------------------------------------------------------------------
#  Render menyuntikkan DATABASE_URL secara otomatis begitu database dibuat dari
#  Blueprint render.yaml, atau begitu database dihubungkan lewat dashboard.
#  JANGAN tulis manual: di render.yaml penyuntikannya ditulis sebagai
#  `fromDatabase`, jadi Render yang mengambil nilainya sendiri dari database.
#
#  Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
#
#  config/database.php membacanya lewat env('DATABASE_URL'), dan Laravel mengurai
#  string itu secara otomatis menjadi host/port/database/username/password.
#  Kalau DATABASE_URL diisi, variabel DB_* di bawah DIABAIKAN.
#
#  Render memakai URL-encoded untuk password. Jangan diedit manual.
#    karakter #, @, /, atau : di password harus tetap dalam bentuk %XX.
#  Password TIDAK boleh di-URL-encode dua kali, atau autentikasi akan gagal.
# DATABASE_URL=postgresql://simrs:PASSWORD_ANDA@HOST:5432/simrs_ews


#  ---------------------------------------------------------------------------
#  2B. CARA B  ->  pakai variabel terpisah (dipakai untuk Docker lokal)
#  ---------------------------------------------------------------------------
#  Hanya perlu diisi kalau DATABASE_URL kosong. Hapus tanda # di baris yang
#  kamu pakai, dan pastikan DATABASE_URL di atas TIDAK ikut terisi.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=simrs_ews
DB_USERNAME=simrs
DB_PASSWORD=simrs_local_password

# SSL PostgreSQL.
#   require = selalu pakai TLS (wajib kalau diakses dari luar jaringan Render)
#   prefer  = pakai TLS kalau tersedia (cukup untuk koneksi internal Render,
#             yang tidak keluar dari jaringan privat)
#   disable = tanpa TLS, jangan pakai di produksi
# Render memberi nilai lewat query string di DATABASE_URL (?sslmode=require),
# yang otomatis menang atas nilai di sini.
DB_SSLMODE=prefer

# Encoding karakter. utf8 WAJIB untuk PostgreSQL, dan cocok dengan teks
# Bahasa Indonesia di data observe.
DB_CHARSET=utf8

# Kolasi. HANYA berlaku untuk MySQL/MariaDB, DIABAIKAN oleh PostgreSQL.
# Dibiarkan di sini hanya agar tidak dianggap "missing".
DB_COLLATION=utf8mb4_unicode_ci

# Aktifkan foreign key untuk SQLite. Untuk PostgreSQL selalu aktif dan variabel
# ini TIDAK dipakai. Hanya relevan kalau DB_CONNECTION=sqlite.
DB_FOREIGN_KEYS=true

# Socket UNIX. Hanya untuk MySQL, DIABAIKAN oleh PostgreSQL.
# DB_SOCKET=

# URL database alternatif dengan format non-standar. JANGAN dipakai bersamaan
# dengan DATABASE_URL. Hampir selalu dikosongkan.
# DB_URL=

# Keduanya HANYA untuk SQL Server. Tidak dipakai aplikasi ini, tapi dibiarkan
# sebagai dokumentasi bahwa tidak ada opsi yang tersembunyi.
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false
# MYSQL_ATTR_SSL_CA=/path/ca.pem


# ###########################################################################
#  3. SESSION
# ###########################################################################
#
#  WAJIB "database" di produksi.
#  Jangan pakai "file": file session disimpan di storage/framework/sessions
#  yang ADA DI DALAM container. begitu ada 2 replica atau container di-restart,
#  seluruh user langsung logout, dan itu penyebab "session tidak bertahan"
#  yang paling sering dilaporkan. Tabel `sessions` sudah ada di migrasi
#  (0001_01_01_000000_create_users_table.php), jadi tidak perlu migrate tambahan.
SESSION_DRIVER=database

# Koneksi DB yang dipakai untuk session. Kosongkan = memakai koneksi default
# (yaitu pgsql). Dipakai hanya kalau session dipindah ke DB terpisah.
# SESSION_CONNECTION=

# Nama tabel session. Jangan diubah, kecuali kamu tahu apa yang kamu lakukan.
SESSION_TABLE=sessions

# Umur session dalam MENIT tanpa aktivitas. 120 = 2 jam, wajar untuk petugas
# kesehatan yang mengisi form observasi. Session yang kedaluwarsa dihapus
# otomatis oleh "session lottery" Laravel.
SESSION_LIFETIME=120

# Kalau true, session langsung berakhir saat browser ditutup. Untuk aplikasi
# klinik ini JANGAN: petugas bisa membiarkan tab terbuka antar shift.
SESSION_EXPIRE_ON_CLOSE=false

# Enkripsi isi session sebelum disimpan. Umumnya tidak perlu (cookie-nya sudah
# terenkripsi oleh APP_KEY), tapi nyalakan kalau data session sangat sensitif.
SESSION_ENCRYPT=false

# Path dan domain cookie. Path "/" = berlaku untuk semua path (benar).
# Domain KOSONGKAN supaya browser hanya mengirim cookie ke host yang memang
# melakukan login. Mengisi domain yang terlalu luas (".contoh.com") membuka
# session fixation dari subdomain lain.
SESSION_PATH=/
# SESSION_DOMAIN=

# Kirim cookie hanya lewat HTTPS. WAJIB true di produksi karena Render sudah
# menyediakan HTTPS gratis. Mengosongkannya membuat cookie tetap terkirim saat
# website diakses via HTTP, sehingga bisa dicegat.
SESSION_SECURE_COOKIE=true

# Atribut SameSite cookie.
#   lax  = REKOMENDASI. Cookie tidak dikirim pada POST lintas situs, sehingga
#          tombol login tetap bekerja CSRF-safe.
#   strict= paling aman, tapi cookie tidak terkirim saat datang dari link
#          eksternal, sehingga user harus login dua kali.
#   none  = wajib kalau SESSION_SECURE_COOKIE=true DAN ada iframe pihak ketiga.
SESSION_SAME_SITE=lax

# Cookie tidak boleh dibaca JavaScript (mitigasi XRF). WAJIB true.
SESSION_HTTP_ONLY=true

# Cookie ikut dikunci ke situs tingkat atas. Hanya berguna bersama
# SESSION_SAME_SITE=none, dan tidak dipakai di sini.
SESSION_PARTITIONED_COOKIE=false

# Cache store yang memegang session, HANYA untuk driver memcached/redis/dynamodb.
# Tidak relevan saat SESSION_DRIVER=database.
# SESSION_STORE=


# ###########################################################################
#  4. CACHE
# ###########################################################################
#
#  WAJIB "database" di produksi, dengan alasan yang sama seperti session:
#  cache berbasis file hilang setiap container di-restart dan tidak dibagi antar
#  replica. Tabel `cache` dan `cache_locks` sudah ada di migrasi
#  (0001_01_01_000001_create_cache_table.php).
#
#  Alternatif yang sah: "redis" (butuh instance Redis di Render) atau "array"
#  (hanya untuk testing, cache selalu kosong tiap request).
CACHE_STORE=database

# Prefix untuk semua key cache. WAJIB diisi kalau nanti memakai layanan cache
# yang dipakai aplikasi lain, supaya tidak saling menimpa. Mengosongkan aman
# selama aplikasi ini satu-satunya pemakainya.
CACHE_PREFIX=

# Koneksi/tabel cache khusus. Kosongkan = pakai koneksi dan tabel default.
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=cache_locks

# Cache memakai koneksi REDIS (dipakai kalau CACHE_STORE=redis).
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default


# ###########################################################################
#  5. QUEUE  -  aplikasi ini TIDAK punya job antrean
# ###########################################################################
#
#  "sync" = job langsung dieksekusi di proses yang sama. Benar untuk aplikasi
#  ini karena tidak ada satupun job yang di-dispatch. Kalau suatu saat ada
#  processEmail atau processExport, pindahkan ke "database" DAN tambahkan
#  service queue di Render, atau job akan menumpuk tanpa pernah diproses.
QUEUE_CONNECTION=sync

# Koneksi/tabel antrean. Hanya relevan kalau QUEUE_CONNECTION=database.
# DB_QUEUE_CONNECTION=
# DB_QUEUE=jobs
# DB_QUEUE_TABLE=jobs
# DB_QUEUE_RETRY_AFTER=90

# Driver untuk tabel `failed_jobs`.
# QUEUE_FAILED_DRIVER=database-uuids

# --- Backend antrean lain (tidak dipakai, dicatat agar lengkap) -----------
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_HOST=
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_QUEUE=default
# SQS_PREFIX=https://sqs.amazonaws.com/123456789012
# SQS_SUFFIX=
# REDIS_QUEUE=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE_RETRY_AFTER=90


# ###########################################################################
#  6. BROADCASTING
# ###########################################################################
#
#  "log" = event ditulis ke log, tidak ada koneksi websocket yang dibuka.
#  Benar untuk aplikasi ini: tidak ada notifikasi realtime. Menyetel
#  "reverb"/"pusher" tanpa service yang sesuai hanya menambah resource sia-sia.
BROADCAST_CONNECTION=log


# ###########################################################################
#  7. FILESYSTEM
# ###########################################################################
#
#  "local" = tulis ke storage/app. Benar karena aplikasi ini tidak punya
#  upload file dari pengguna. Kalau nanti ada upload radiologi, pindahkan ke
#  "s3" dan set variabel AWS di bagian 11.
FILESYSTEM_DISK=local


# ###########################################################################
#  8. LOGGING
# ###########################################################################
#
#  WAJIB "stderr" di Render.
#  Render hanya menangkap stdout dan stderr container. Kalau LOG_CHANNEL=stack
#  atau single, log ditulis ke file storage/logs/laravel.log yang berada DI
#  DALAM container -- dan file itu hilang begitu container di-restart. Gejalanya:
#  "error 500 tapi log-nya kosong".
LOG_CHANNEL=stderr

# Level log minimum.
#   debug = sangat Detail (jangan di produksi, membanjiri kuota log)
#   info  = REKOMENDASI
#   warning / error = lebih sedikit, tapi deteksi masalah jadi lambat
LOG_LEVEL=info

# Channel tempat log deprecation PHP ditulis. "null" membuangnya.
LOG_DEPRECATIONS_CHANNEL=null

# Kalau true, deprecation dicatat lengkap dengan stack trace.
LOG_DEPRECATIONS_TRACE=false

# Dipakai HANYA kalau LOG_CHANNEL=stack, jadi tidak aktif di produksi. Dicatat
# agar tidak ada opsi yang tersembunyi.
LOG_STACK=single

# -- Channel lain (tidak dipakai) -------------------------------------------
# LOG_STDERR_FORMATTER=Monolog\Formatter\LineFormatter
# LOG_SYSLOG_FACILITY=LOG_USER
# LOG_DAILY_DAYS=14
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=
# LOG_SLACK_EMOJI=
# LOG_PAPERTRAIL_HANDLER=syslog
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# -- Integrasi pihak ketiga (tidak dipakai) ---------------------------------
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# POSTMARK_MESSAGE_STREAM_ID=


# ###########################################################################
#  9. EMAIL
# ###########################################################################
#
#  "log" = email ditulis ke log, tidak benar-benar dikirim. Ini default yang
#  AMAN supaya tidak ada email sungguhan yang terkirim ke domain sungguhan
#  saat lupa mengatur konfigurasi.
#  Kalau nanti butuh kirim email sungguhan (mis. reset password), ganti ke
#  smtp dan isi MAIL_HOST/PORT/USERNAME/PASSWORD.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_URL=null
MAIL_EHLO_DOMAIN=null
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
MAIL_LOG_CHANNEL=null

# Alamat pengirim. WAJIB diganti kalau MAIL_MAILER bukan "log", supaya email
# tidak ditolak karena pengirim tidak dikenal.
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"


# ###########################################################################
# 10. AUTHENTIKASI
# ###########################################################################
#
#  Semuanya dibiarkan kosong supaya memakai default Laravel, yang sudah cocok
#  dengan model User dan tabel users di aplikasi ini. Jangan diisi asal.
# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800


# ###########################################################################
# 11. S3 / AWS  -  hanya perlu kalau FILESYSTEM_DISK=s3
# ###########################################################################
#
#  DIAPLIKASI INI: tidak dipakai. Jangan isi kredensial AWS yang tidak perlu;
#  setiap credential yang ada di environment adalah satu credential yang bisa
#  bocor. Render menyediakan add-on S3 kalau nanti dibutuhkah.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false


# ###########################################################################
# 12. REDIS  -  tidak dipakai
# ###########################################################################
#
#  Aplikasi ini memakai database untuk session dan cache, jadi Redis tidak
#  diperlukan. Kalau nanti ditambah (untuk memindahkan cache ke memori),
#  tambahkan instance Redis di Render, lalu ubah CACHE_STORE=redis dan
#  SESSION_DRIVER=redis. Pastikan ekstensi phpredis terpasang di image --
#  image produksi saat ini sengaja TIDAK memasangnya, jadi ada satu langkah
#  tambahan pada Dockerfile bila Anda memilih jalur ini.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PREFIX=simrs-rsp-rotinsulu-cache-
# REDIS_CLUSTER=redis
# REDIS_PERSISTENT=false
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000


# ###########################################################################
# 13. MEMCACHED / DYNAMODB  -  tidak dipakai
# ###########################################################################
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=null
# MEMCACHED_PASSWORD=null
# MEMCACHED_PERSISTENT_ID=null
# DYNAMODB_CACHE_TABLE=
# DYNAMODB_ENDPOINT=


# ###########################################################################
# 14. TOGGLE RUNTIME  -  dibaca oleh docker/entrypoint.sh
# ###########################################################################
#
#  Variabel di bagian ini BUKAN config Laravel. Semuanya dibaca langsung oleh
#  shell script entrypoint, bukan oleh PHP. Mengubahnya lewat dashboard Render
#  tetap bekerja karena entrypoint membaca environment saat container start.

# --- Migrasi otomatis saat container start -------------------------------
#   false = AMAN (default produksi). Migrasi dijalankan manual:
#              render run php artisan migrate --force
#            atau lewat shell ke dalam container:
#              render ssh --service simrs-ews-app
#            Ini memberi kamu kesempatan membaca output migrasi SEBELUM data
#            berubah, dan mudah dikembalikan kalau migrasi gagal.
#   true  = container menjalankan `php artisan migrate --force` tiap boot,
#            setelah menunggu PostgreSQL siap. Dipakai kalau kamu tidak bisa
#            menjalankan `render run`. WAJIB ada DATABASE_URL.
#  PERINGATAN: dengan true, migrasi yang salah akan ikut dijalankan OTOMATIS
#   pada deploy berikutnya. Untuk data klinis, `false` + migrasi manual hampir
#   selalu pilihan yang lebih aman.
RUN_MIGRATIONS=false

# --- Seed data demo saat container start ---------------------------------
#  WAJIB false di produksi. Seeder data klinis tidak idempoten total:
#   menjalankannya pada database yang sudah berisi data pasien nyata berisiko
#   menduplikasi baris. Untuk lingkungan demo, jalankan manual SATU KALI:
#       render run php artisan db:seed --force
#   ...lalu biarkan tetap false selamanya.
SEED_DEMO_DATA=false

# --- Cache artefak Laravel saat boot -------------------------------------
#   true (default)  = config:cache, route:cache, view:cache dijalankan.
#                     Wajib di produksi: mempercepat setiap request.
#   false           = HANYA untuk debug. config:cache menyembunyikan nilai
#                     env, jadi salah ketik nama variable baru ketahuan.
#                     Pakai false sementara, clear cache, lalu kembalikan true.
CACHE_CONFIG=true
CACHE_ROUTES=true
CACHE_VIEWS=true

# --- Batas kesabaran menunggu PostgreSQL ---------------------------------
# Total-detik = DB_WAIT_SECONDS. Render menjalankan container app dan
# container Postgres secara paralel, jadi Postgres butuh beberapa detik untuk
# siap menerima koneksi. 60 detik cukup; kalau gagal dalam 60 detik, berarti
# konfigurasi database-nya salah dan lebih baik gagal cepat dengan pesan jelas.
DB_WAIT_SECONDS=60
DB_WAIT_INTERVAL=2

# --- Path dan user internal (jangan diubah kecuali paham konsekuensinya) ---
# Direktori aplikasi di dalam container, dan user non-root yang dipakai.
# APP_DIR=/var/www/html
# RUN_USER=www-data
# RUN_GROUP=www-data
#
# Lokasi konfigurasi nginx. NGINX_CONF adalah file hasil COPY saat build
# (root:root, 0644, tidak bisa ditulis user non-root). NGINX_RUNTIME_CONF adalah
# salinannya di /tmp yang boleh ditulis - itulah yang sebenarnya dipakai nginx
# lewat flag -c. Jangan diubah kecuali kamu paham konsekuensinya.
# NGINX_CONF=/etc/nginx/nginx.conf
# NGINX_RUNTIME_CONF=/tmp/nginx-runtime.conf

# --- Worker PHP built-in, KHUSUS untuk `php artisan serve` ----------------
# Berapa banyak worker paralel untuk `php -S` (server bawaan PHP).
#
# CATATAN PENTING: variabel ini TIDAK berlaku di Render dan TIDAK berlaku di
# jalur Docker (nginx + php-fpm). `php -S` tidak pernah dijalankan di produksi,
# jadi nilainya diabaikan sepenuhnya.
#
# Nilainya sengaja TIDAK dihapus supaya tidak membingungkan siapa pun yang
# menemukan variabel ini di dokumentasi Laravel. Kalau nanti kamu memakai
# `php artisan serve` di lingkungan lain, angka inilah yang mengatur jumlah
# worker-nya.
#
# Yang mengatur jumlah worker di produksi adalah:
#     docker/php-fpm.d/zz-app.conf  ->  pm.max_children
PHP_CLI_SERVER_WORKERS=4


# ###########################################################################
# 15. BAGIAN KHUSUS RENDER  -  DISUNTIK PLATFORM, JANGAN DIISI MANUAL
# ###########################################################################
#
#  Ketiga variabel di bawah disuntikkan oleh Render sendiri ke dalam container.
#  Di dashboard Render, ketiganya tampil sebagai "read-only" - itu bukan error.
#  Tidak ada yang perlu kamu ketik, dan sengaja mengisinya hampir selalu salah.
#
#  Blok ini hanya DOKUMENTASI. Barisnya dibiarkan kosong dan aman: nilai kosong
#  dianggap "tidak di-set" oleh seluruh config/ dan oleh docker/entrypoint.sh.


# --- PORT -------------------------------------------------------------------
# Disuntikkan platform sebagai ANGKA ACAK setiap kali instance dijadwalkan,
# lalu Render mengarahkan trafik publik ke angka itu.
#
# PENTING: aplikasi TIDAK boleh mempercayai angka tetap. Kalau nginx tetap
# listen di 8080 sementara Render menunggu port acak, container akan booted
# yang terlihat SEHAT tapi tidak pernah bisa dihubungi (selalu 502).
#
# Yang mencegah itu adalah docker/entrypoint.sh: sebelum nginx dijalankan, ia
# menyalin docker/nginx.conf ke /tmp lalu mengganti direktif `listen 8080`
# menjadi `listen ${PORT}` (defaultnya 8080 kalau PORT kosong). Karena itu angka
# 8080 di dalam image HANYA berlaku untuk `docker compose` lokal.
#
# JANGAN SET di dashboard.
PORT=


# --- DATABASE_URL -----------------------------------------------------------
# Disuntikkan Render begitu database dibuat atau dihubungkan. Kalau deploy lewat
# render.yaml, penyuntikkan ini ditulis sebagai `fromDatabase`, jadi Render yang
# mengambil nilainya dari database tersebut - bukan kita yang mengetik.
#
# Bentuknya: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# config/database.php membacanya lewat env('DATABASE_URL') dan menguraikannya
# otomatis menjadi host/port/database/username/password.
#
# Catatan keamanan: bersama DATABASE_URL, Render juga menyuntikkan PGHOST,
# PGPORT, PGDATABASE, PGUSER, dan PGPASSWORD. JANGAN menyalin nilai-nilai itu
# ke file lain, ke Git, atau ke chat - PGPASSWORD adalah password database.
#
# Nilai kosong aman: Laravel mengabaikannya (vendor/laravel/framework/src/
# Illuminate/Support/ConfigurationUrlParser.php:38 - `if (! $url) return $config`),
# sehingga blok DB_* di bagian 2B yang tetap dipakai.
#
# JANGAN SET di dashboard.
DATABASE_URL=


# --- RENDER -----------------------------------------------------------------
# Disuntikkan platform, bernilai true di dalam container Render. Berguna untuk
# membedakan lingkungan saat menulis log atau logika lain.
#
# Tidak dibaca config/ maupun entrypoint saat ini; cukup didokumentasikan supaya
# tidak mengira ada variabel Render lain yang perlu dibuat sendiri.
#
# JANGAN SET di dashboard.
RENDER=

# ###########################################################################
#  16. BAGIAN KHUSUS VERCEL
#  ---------------------------------------------------------------------------
#  Dokumen lengkap: docs/VERCEL.md
#
#  Jalur Vercel adalah OPSIONAL dan TAMBAHAN. Jalur Docker / Railway / Render
#  (bagian 1 sampai 15) tidak berubah sama sekali karena file ini.
#
#  Dua perbedaan besar dari Render yang WAJIB dipahami sebelum menyalin
#  variabel ke dashboard Vercel:
#
#  a) FILESYSTEM READ-ONLY, KECUALI /tmp
#     Semua variabel *_CACHE dan *_PATH di bagian ini diarahkan ke /tmp.
#     Jangan dihapus: tanpa itu Laravel gagal pada setiap request karena
#     tidak bisa menulis hasil compile ke storage/framework/views.
#
#  b) TIDAK ADA BOOT HOOK
#     docker/entrypoint.sh tidak dipakai di Vercel. Tidak ada container yang
#     start, jadi RUN_MIGRATIONS dan SEED_DEMO_DATA (bagian 14) TIDAK
#     berlaku. Migrasi dan seeding dijalankan MANUAL dari mesin lokal
#     terhadap Neon, SEBELUM deploy pertama.
#
#  Catatan penting soal build: runtime PHP di Vercel adalah proyek komunitas
#  (vercel-community/php), bukan produk resmi Vercel. Composer install
#  berjalan otomatis di build step. npm run build TIDAK otomatis - jalankan
#  di mesin lokal sebelum `vercel`, supaya public/build ikut ter-upload.
# ===========================================================================

# --- Path yang boleh ditulis, semuanya di /tmp (WAJIB) ---------------------
# Blade meng-compile view ke sini. Tanpa ini: "unable to write file
# .../storage/framework/views" pada setiap request.
VIEW_COMPILED_PATH=/tmp/views

# Cache artefak Laravel. Secara default nilainya kosong (null) dan aplikasi
# tetap jalan, tapi menunjukkannya ke /tmp membuat aman terhadap percobaan
# menulis ke bootstrap/cache yang read-only.
APP_CONFIG_CACHE=/tmp/config.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_SERVICES_CACHE=/tmp/services.php

# --- PORT ------------------------------------------------------------------
# Disuntikkan platform Vercel ke dalam function. JANGAN SET di dashboard.
#
#  PENTING: runtime vercel-php TIDAK membaca PORT. Fungsi tersebut memanggil
#  PHP built-in server di dalam prosesnya sendiri (port 3000 internal) dan
#  menjawab request dari bridge Vercel. Jadi tidak ada nomor port yang perlu
#  diisi di mana pun - berbeda dari Render (bagian 15) yang memakai PORT
#  untuk menentukan listen nginx.
PORT=