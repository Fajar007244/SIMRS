# ===========================================================================
#  .vercelignore  -  berkas mana yang TIDAK ikut ter-upload ke Vercel
#
#  README FAQ 4 dari vercel-community/php menyatakan composer install berjalan
#  di build step Vercel memakai PHP bawaan runtime, sehingga /vendor tidak
#  perlu dikirim dan SEBAIKNYA tidak dikirim (menghemat ukuran upload).
#  File /vendor hasil build itulah yang dipakai saat request.
#  Lihat juga FAQ 7: script composer bernama "vercel" bisa memanggil
#  npm/node di build step.
#
#  Dependensi frontend punya aturan sendiri: /node_modules di bawah TIDAK ikut
#  di-upload karena runtime PHP yang memasangnya ulang (npm ci) lalu menjalankan
#  vite build di build step Vercel.
#  ---------------------------------------------------------------------------
#  CARA MEMBANGUN ASET: vercel.json memakai "builds", jadi hanya ada SATU
#  builder (vercel-php) dan tidak ada builder frontend sama sekali. Runtime itu
#  menjalankan "composer install" lalu "composer run vercel" (lihat composer.json
#  scripts.vercel), dan script itulah yang menjalankan npm ci + vite build.
#  Hasilnya masuk ke public/build DI DALAM folder kerja runtime, lalu ikut
#  ter-GLOB ke dalam function - bukan karena di-upload dari sini.
#  Jangan menaruh "buildCommand" atau "outputDirectory" di vercel.json: keduanya
#  akan mengaktifkan @vercel/static-build, yang mensyaratkan folder "dist" dan
#  menggagalkan deploy dengan "No Output Directory named \"dist\" found".
# ===========================================================================

# --- Dependency: dipasang ulang di Vercel saat build ----------------------
/vendor
/node_modules

# --- Metadata repository --------------------------------------------------
/.git
/.gitattributes
/.gitignore

# --- Rahasia: TIDAK PERNAH di-upload ---------------------------------------
#  Seluruh secret (APP_KEY, DATABASE_URL) ada di Environment Variables Vercel.
#  Kalau .env ikut ter-upload, isinya bocor ke dalam deployment.
/.env
/.env.local
/.env.*.local
/.env.production

# --- Sisa pekerjaan lokal -------------------------------------------------
/.phpunit.result.cache
/storage/logs
/database/*.sqlite
/database/*.sqlite-journal

# ===========================================================================
#  YANG SENGAJA TIDAK DI-IGNORE
#  ---------------------------------------------------------------------------
#  public/build  ->  SENGAJA tidak ikut ter-upload. Folder ini masih ada di
#                    .gitignore, dan itu benar: yang menghasilkannya di Vercel
#                    adalah "composer run vercel" (npm ci + vite build + cek
#                    manifest), bukan isi folder lokal.
#                    Kalau public/build ikut ter-upload justru BERBAHAYA: Vite
#                    menimpa folder itu setiap build, dan hash aset bisa basi
#                    bila yang terkirim tidak sama dengan source yang dideploy.
#                    Kalau public/build TIDAK ada di dalam function, itu berarti
#                    composer run vercel gagal (bukan kamu lupa build di lokal) -
#                    script itu sudah mengecek manifest.json dan menggagalkan
#                    build dengan pesan yang menyebut ViteManifestNotFound.
#  public/favicon.ico dan public/robots.txt -> dilayani api/index.php.
#  storage/framework/views -> hanya berisi .gitignore; view hasil compile
#                    ditulis ke /tmp (VIEW_COMPILED_PATH), bukan ke sini.
#  tests/, docs/, docker/, scripts/ -> tidak dibuild, tapi ukurannya kecil
#                    dan berguna kalau perlu dibaca dari build log.
# ===========================================================================